// ===========================================================================
// MI_GetHackType  ORIG T 0x8274ad7：value = (unsigned char)c + 0x6a4，
// 上限 0x707（jle 保持）。
// ===========================================================================
int MI_GetHackType(char c)
{
    int v = (c & 0xff) + 0x6a4;
    if (v > 0x707)
        v = 0x707;
    return v;
}