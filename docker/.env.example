# 复制为 docker/.env 后修改；.env 已在 .gitignore 中，不要提交
PUBLIC_IP=192.168.1.100          # 客户端能访问到的 IP（局域网 IP 或公网 IP）
DNF_DB_ROOT_PASSWORD=change_me_root
DNF_DB_GAME_PASSWORD=game1234    # 只取前 8 位
SERVER_GROUP=3                   # 3=希洛克，决定端口 3xxxx
SERVER_GROUP_NAME=siroco
SERVER_GROUP_DB=cain
OPEN_CHANNEL=11,52
# DNF_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/centos-vault
# MYSQL_PUBLISH=127.0.0.1:3000
# 登录网关（dnf-gate-server，端口 5505）。AES_KEY 需与登录器一致；GATE_ENABLE=0 可关闭
GATE_ENABLE=1
GATE_AES_KEY=
GATE_REGISTRATION_OPEN=true
INITIAL_CERA=1000
