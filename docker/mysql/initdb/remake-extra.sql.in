-- ---------- d_taiwan_secu（db_type 10）：决斗场“学院”----------
-- Game/W8LT_DBTask.cpp:4017/4096（DB_HANDLE_10；rating 为 get_float）+ DB_Login/GetSchoolName.inc:4（get_str 0x28）
CREATE TABLE IF NOT EXISTS d_taiwan_secu.school_info (
  school_id int(11) NOT NULL DEFAULT '0',
  school_name varchar(40) NOT NULL DEFAULT '',
  rating float NOT NULL DEFAULT '0',
  fight_cnt int(11) NOT NULL DEFAULT '0',
  fight_cnt_prev int(11) NOT NULL DEFAULT '0',
  school_point int(11) NOT NULL DEFAULT '0',
  school_point_prev int(11) NOT NULL DEFAULT '0',
  last_update_time datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  PRIMARY KEY (school_id)
) ENGINE=MyISAM DEFAULT CHARSET=utf8;
-- Game/W8LT_DBTask.cpp:4148、dispatch_200.inc:25、DB_Login/GetBadgeCount.inc:10（DB_HANDLE_10）、
-- DB_LoadCharac/_UpdateSchoolCharac.inc:15（handle 0x10，db_connect 中无 16 → 该路径取不到句柄）
CREATE TABLE IF NOT EXISTS d_taiwan_secu.school_member (
  school_id int(11) NOT NULL DEFAULT '0',
  m_id int(10) unsigned NOT NULL DEFAULT '0',
  charac_no int(10) unsigned NOT NULL DEFAULT '0',
  job tinyint(4) NOT NULL DEFAULT '0',
  grow_type tinyint(4) NOT NULL DEFAULT '0',
  lev smallint(6) NOT NULL DEFAULT '0',
  contribute int(11) NOT NULL DEFAULT '0',
  green_badge int(11) NOT NULL DEFAULT '0',
  red_badge int(11) NOT NULL DEFAULT '0',
  blue_badge int(11) NOT NULL DEFAULT '0',
  daily_green_badge int(11) NOT NULL DEFAULT '0',
  daily_red_badge int(11) NOT NULL DEFAULT '0',
  daily_blue_badge int(11) NOT NULL DEFAULT '0',
  last_play_time datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  PRIMARY KEY (school_id, m_id)
) ENGINE=MyISAM DEFAULT CHARSET=utf8;

-- ---------- d_taiwan（db_type 1）：账号级活动 ----------
-- Game/W8LT_DBTask.cpp:1312/1317（DB_HANDLE_1）
CREATE TABLE IF NOT EXISTS d_taiwan.event_happybean_log (
  occ_date datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  m_id int(10) unsigned NOT NULL DEFAULT '0',
  cnt int(11) NOT NULL DEFAULT '0',
  KEY idx_mid (m_id, occ_date)
) ENGINE=InnoDB DEFAULT CHARSET=utf8;
-- 下列 6 张“领奖记录”表同一模式（WongWorkEvents_A / LinkClosureB_Misc，DB_HANDLE_1）：
--   按 m_id + occ_check!=0 列出，按 id 读/写 *_check=unix_timestamp(now())
-- WongWorkEvents_A.cpp:269 + CheckAlready/Update*
CREATE TABLE IF NOT EXISTS d_taiwan.event_everland_info (
  id int(10) unsigned NOT NULL AUTO_INCREMENT,
  m_id int(10) unsigned NOT NULL DEFAULT '0',
  server_id int(11) NOT NULL DEFAULT '0',
  charac_no int(10) unsigned NOT NULL DEFAULT '0',
  coin int(11) NOT NULL DEFAULT '0',
  coin_check int(11) NOT NULL DEFAULT '0',
  occ_check int(11) NOT NULL DEFAULT '0',                   -- 猜测（只出现在 where occ_check!=0）
  PRIMARY KEY (id), KEY idx_mid (m_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8;
-- LinkClosureB_Misc/ArrangeATIEventItem.inc:25 / CheckAlreadyGetATIItem / UpdateEventATIInfo
CREATE TABLE IF NOT EXISTS d_taiwan.event_ati_info (
  id int(10) unsigned NOT NULL AUTO_INCREMENT,
  m_id int(10) unsigned NOT NULL DEFAULT '0',
  cera int(11) NOT NULL DEFAULT '0',
  cera_check int(11) NOT NULL DEFAULT '0',
  item_no int(11) NOT NULL DEFAULT '0',
  item_server_id int(11) NOT NULL DEFAULT '0',
  item_charac_no int(10) unsigned NOT NULL DEFAULT '0',
  item_check int(11) NOT NULL DEFAULT '0',
  avata_no1 int(11) NOT NULL DEFAULT '0',
  avata_no2 int(11) NOT NULL DEFAULT '0',
  avata_server_id int(11) NOT NULL DEFAULT '0',
  avata_charac_no int(10) unsigned NOT NULL DEFAULT '0',
  avata_check1 int(11) NOT NULL DEFAULT '0',
  avata_check2 int(11) NOT NULL DEFAULT '0',
  occ_check int(11) NOT NULL DEFAULT '0',                   -- 猜测
  PRIMARY KEY (id), KEY idx_mid (m_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8;
-- WongWorkEvents_A.cpp:167 / CheckAlreadyGetSigongItem / UpdateEventSigongInfo
CREATE TABLE IF NOT EXISTS d_taiwan.event_sigong_info (
  id int(10) unsigned NOT NULL AUTO_INCREMENT,
  m_id int(10) unsigned NOT NULL DEFAULT '0',
  item1_no int(11) NOT NULL DEFAULT '0',
  item1_server_id int(11) NOT NULL DEFAULT '0',
  item1_charac_no int(10) unsigned NOT NULL DEFAULT '0',
  item1_check int(11) NOT NULL DEFAULT '0',
  item2_no int(11) NOT NULL DEFAULT '0',
  item2_server_id int(11) NOT NULL DEFAULT '0',
  item2_charac_no int(10) unsigned NOT NULL DEFAULT '0',
  item2_check int(11) NOT NULL DEFAULT '0',
  occ_check int(11) NOT NULL DEFAULT '0',                   -- 猜测
  PRIMARY KEY (id), KEY idx_mid (m_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8;
