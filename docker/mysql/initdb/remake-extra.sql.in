  occ_date datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  stage int(11) NOT NULL DEFAULT '0',
  stage_result varchar(64) NOT NULL DEFAULT '',            -- 猜测（'%s'）
  KEY idx_ev (event_id, m_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8;
-- Game/DB_LoadEtc/LoadPcRoomPlayTimeInfo.inc:24（handle 9；只见 SELECT）
